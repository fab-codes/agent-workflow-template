{
  "tasks": {
    "check": "deno check .",
    "test": "deno test --allow-env",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "invariants": "deno run --allow-read scripts/check-invariants.ts",
    "verify": {
      "dependencies": ["check", "lint", "fmt:check", "test", "invariants"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "exclude": ["**/*.md", ".claude/**/*.md", ".github/**/*.md"],
    "lineWidth": 110,
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false,
    "indentWidth": 2
  },
  "lint": {
    "include": ["src/", "tests/", "scripts/", ".claude/hooks/"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "no-console",
        "no-eval",
        "no-throw-literal",
        "eqeqeq",
        "explicit-module-boundary-types",
        "no-sync-fn-in-async-fn",
        "verbatim-module-syntax"
      ]
    }
  }
}
